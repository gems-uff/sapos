# Development and test run on SQLite so you can try SAPOS without installing a
# database server. Production runs on MariaDB/MySQL: see the commented block at
# the end of this file and the production install guide on the wiki.
development:
  adapter: sqlite3
  database: db/development.sqlite3
  pool: 5
  timeout: 5000

# Read-only connection used by user-defined queries and notifications. When
# absent, SAPOS falls back to the main environment.
development_read_only:
  adapter: sqlite3
  database: db/development.sqlite3
  pool: 5
  timeout: 5000

# The test database is erased and regenerated by rake. Never point it at your
# development or production database.
test:
  adapter: sqlite3
  database: db/test.sqlite3
  pool: 5
  timeout: 5000

production:
  adapter: sqlite3
  database: db/production.sqlite3
  pool: 5
  timeout: 5000

# --- MariaDB / MySQL (production) -------------------------------------------
# encoding is the character set (utf8mb4 = full UTF-8). collation is the rule
# for comparing and sorting strings (utf8mb4_unicode_ci: case- and accent-
# insensitive). To run on MariaDB, replace the production blocks above with:
#
# production:
#   adapter: mysql2
#   encoding: utf8mb4
#   collation: utf8mb4_unicode_ci
#   database: <database name>
#   username: <user>
#   password: <password>
#   socket: /var/run/mysqld/mysqld.sock
#   pool: 5
#
# production_read_only:
#   adapter: mysql2
#   encoding: utf8mb4
#   collation: utf8mb4_unicode_ci
#   database: <database name>
#   username: <read-only user>
#   password: <password>
#   socket: /var/run/mysqld/mysqld.sock
#   pool: 5
