<%
  options = {size: 30}
  options[:required] = "required" if configuration["required"]
  # O campo sincronizado com o e-mail e conferido pelo navegador como o campo
  # de e-mail da tela (o servidor confere de novo, no modelo).
  input = form_field.sync == Admissions::FormField::SYNC_EMAIL ? :email_field : :text_field
%>
<li class="form-element <%= configuration["required"] ? "required" : "" %>">
  <dl>
    <dt>
      <%= field.label :value, form_field.name %>
      <% if form_field.description.present? %>
        <span class="filled-form-description"><%= form_field.description %></span>
      <% end %>
    </dt>
    <dd> <%= field.public_send input, :value, class: ["text-input", filled_class],
             placeholder: configuration["placeholder"], **options %> </dd>
  </dl>
</li>
