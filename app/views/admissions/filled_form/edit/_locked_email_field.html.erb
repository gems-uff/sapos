<%# O campo sincronizado com o e-mail da candidatura, para quem nao o troca
    por esta tela. O valor segue no envio, como a tela o recebeu, para que o
    formulario continue completo. %>
<li class="form-element">
  <dl>
    <dt>
      <%= field.label :value, form_field.name %>
      <% if form_field.description.present? %>
        <span class="filled-form-description"><%= form_field.description %></span>
      <% end %>
    </dt>
    <dd> <%= field.text_field :value, class: ["text-input", filled_class], size: 30,
             readonly: true, title: t("admissions.apply.edit.email_locked") %> </dd>
  </dl>
</li>
